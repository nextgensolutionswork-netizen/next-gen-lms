{
  "mode": "Browser-origin API workflow against actual isolated Next server; mock persistence, no Supabase",
  "checks": [
    "pay-later admission saved",
    "local proof uploaded",
    "pending payment recorded",
    "duplicate submission returns same payment",
    "counsellor cannot approve",
    "accountant approval succeeds",
    "repeat approval handled"
  ],
  "network": [
    {
      "role": "counsellor",
      "path": "/api/admissions",
      "status": 200
    },
    {
      "role": "counsellor",
      "path": "/api/fees/payments",
      "status": 200
    },
    {
      "role": "counsellor",
      "path": "/api/fees/payments",
      "status": 200
    },
    {
      "role": "counsellor",
      "path": "/api/fees/payments",
      "status": 403,
      "error": "Separation of duties violation: Payment recorder cannot verify their own payment entry."
    },
    {
      "role": "accounts",
      "path": "/api/fees/payments",
      "status": 200
    },
    {
      "role": "accounts",
      "path": "/api/fees/payments",
      "status": 400,
      "error": "Only a payment pending approval can be approved; it may already be verified or rejected."
    }
  ],
  "preflight": {
    "database": "mock-sap-lms",
    "storage": "mock-sap-lms",
    "backend": "local_disk_mock"
  }
}